diff --git a/integration/SDL2/SDL_ps5g19.c b/integration/SDL2/SDL_ps5g19.c
index 210bd7b..95e5742 100644
--- a/integration/SDL2/SDL_ps5g19.c
+++ b/integration/SDL2/SDL_ps5g19.c
@@ -9,6 +9,9 @@
 #include <EGL/egl.h>
 #include <EGL/eglext.h>
 #include "ps5g19_display.h"
+#if __has_include(<ps5_opengl_display_modes.h>)
+#include <ps5_opengl_display_modes.h>
+#endif
 
 /* ponytail: one fixed-profile window/context on the video thread; extend only with a
  * separately validated EGL ownership contract. No private presentation API. */
@@ -42,6 +45,11 @@ static int video_init(_THIS)
     g->thread = SDL_ThreadID();
     g->display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
     if (g->display == EGL_NO_DISPLAY) return egl_error("eglGetDisplay");
+#ifdef PS5_OPENGL_DYNAMIC_DISPLAY
+    /* mode d affichage choisi avant l initialisation (1080p par defaut sinon) */
+    eglSetDisplayModePS5(g->display, PS5_OPENGL_NATIVE_WIDTH, PS5_OPENGL_NATIVE_HEIGHT);
+    eglSetDisplayRefreshPS5(g->display, PS5_OPENGL_NATIVE_FPS);
+#endif
     if (!eglInitialize(g->display, NULL, NULL)) {
         g->display = EGL_NO_DISPLAY;
         return egl_error("eglInitialize");
